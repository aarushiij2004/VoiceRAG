GEMINI_API_KEY=your-key-here

# Optional overrides (defaults live in config.py)
# GEMINI_MODEL=gemini-3.6-flash   # newer: gemini-3.8-flash. Must be a model your key can access.
# GEMINI_THINKING_LEVEL=low       # low = faster answers; empty = model default
# RETRIEVAL_MODE=hybrid           # dense | bm25 | hybrid
# MIN_SIMILARITY=0.25             # calibrate with: python eval.py --modes dense --calibrate
# CHUNK_SIZE=200
# CHUNK_OVERLAP=40
# TOP_K=4
